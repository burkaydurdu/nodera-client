# Deployment environment name (dev | test | alpha | prod). Inlined at build time.
ENV=dev

# Customer gateway base URL. Every request carries `X-Target-Server` (customer, droplet, billing
# or notification, chosen from the request path in api/proxy.ts). The realtime WebSocket opens
# on the same URL, ws/wss instead of http/https, under /v1/realtime.
GATEWAY_API_URL=http://localhost:3460
