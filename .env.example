# Deployment environment name (dev | test | alpha | prod). Inlined at build time.
ENV=dev

# Customer gateway base URL. Every request carries `X-Target-Server` (customer, droplet, billing,
# notification or mail, chosen from the request path in api/proxy.ts). The realtime WebSocket
# opens on the same URL, ws/wss instead of http/https, under /v1/realtime.
GATEWAY_API_URL=http://localhost:3460

# Host of Mail's SMTP listener, shown to customers in the Mail App's SMTP settings next to the
# ports 587, 465 and 2525. Inlined at build time; unset, the settings say it is not configured.
MAIL_SMTP_HOST=localhost

# Integration gateway base URL, where software holding a Project API key calls. The Mail App's
# send example points at it. Inlined at build time; dev defaults to http://localhost:3470, any
# other build without it says the API address is not configured.
INTEGRATION_API_URL=http://localhost:3470
